{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hoek Ribbon Delivery v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "deliveryId",
    "packageVersion",
    "generatedAt",
    "sourceRevision",
    "sourceSnapshotId",
    "manifestSha256",
    "actual"
  ],
  "properties": {
    "format": {
      "const": "hoek-ribbon-delivery"
    },
    "version": {
      "const": 1
    },
    "deliveryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceSnapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actual": {
      "type": "object",
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "parent",
              "order",
              "label",
              "tooltip",
              "command",
              "iconHash"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "enum": [
                  "panel",
                  "button",
                  "stack",
                  "dropdown",
                  "separator"
                ]
              },
              "parent": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "maxLength": 500
              },
              "tooltip": {
                "type": "string",
                "maxLength": 12000
              },
              "command": {
                "type": "string",
                "maxLength": 1000
              },
              "iconHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}